async function sendMoney() {
    const modal = document.createElement('div');
    modal.className = 'modal';
    modal.innerHTML = `<div class="modal-content"><h3>💰 SEND MONEY</h3><input type="email" id="userEmail" placeholder="User Email"><input type="number" id="amount" placeholder="Amount (₹)"><button class="btn-green" id="sendBtn">✅ SEND</button><button class="btn-red" id="closeModal">❌ CANCEL</button></div>`;
    document.body.appendChild(modal);
    document.getElementById('sendBtn').onclick = async () => {
        const email = document.getElementById('userEmail').value.trim();
        const amt = parseInt(document.getElementById('amount').value);
        if(!email || !amt) return alert('Fill fields');
        const snap = await db.ref('users').orderByChild('email').equalTo(email).once('value');
        if(!snap.exists()) return alert('User not found');
        snap.forEach(async(s) => { await s.ref.update({ balance: (s.val().balance || 0) + amt }); });
        alert(`✅ ₹${amt} sent to ${email}`);
        modal.remove();
        await loadData();
        home();
    };
    document.getElementById('closeModal').onclick = () => modal.remove();
}

