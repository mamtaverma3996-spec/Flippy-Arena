        usersCache = {};
        usersSnap.forEach(s => { usersCache[s.key] = s.val(); });
    }
    const photosSnap = await db.ref('broadcastPhotos').once('value');
    broadcastPhotos = photosSnap.val() ? Object.entries(photosSnap.val()).map(([id,d])=>({id,...d})) : [];
}

let balanceListener = null;
function startBalanceListener() {
    if(balanceListener) balanceListener();
    if(admin && !admin.isMain) {
        const adminRef = db.ref(`admins/${admin.id}`);
        const callback = adminRef.on('value', (snap) => {
            if(snap.exists() && admin) {
                admin.balance = snap.val().balance || 0;
                const balSpan = document.getElementById('dynamicBalanceSpan');
                if(balSpan) balSpan.innerText = `₹${admin.balance}`;
            }
        });
        balanceListener = () => adminRef.off('value', callback);
    }
}

function main() {
