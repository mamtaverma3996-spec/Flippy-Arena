window.deleteTournament = async (id, fees) => {
    const t = tournaments.find(x=>x.id===id);
    if(!t) return;
    const participants = t.participants || {};
    const playerCount = Object.keys(participants).length;
    const totalRefund = playerCount * fees;
    if(!confirm(`⚠️ DELETE "${t.name}"\n\nPlayers: ${playerCount}\nRefund: ₹${totalRefund}\n\nThis will be DEDUCTED from your wallet.\nContinue?`)) return;
    if(!admin.isMain && admin.balance < totalRefund) { alert(`❌ Insufficient balance!\nYour Balance: ₹${admin.balance}\nRefund Needed: ₹${totalRefund}`); return; }
    for(let p of Object.values(participants)) {
        const userSnap = await db.ref('users').orderByChild('email').equalTo(p.email).once('value');
        userSnap.forEach(async(s) => { await s.ref.update({ balance: (s.val()?.balance || 0) + fees }); });
    }
    if(!admin.isMain) { const newBalance = admin.balance - totalRefund; await db.ref(`admins/${admin.id}`).update({ balance: newBalance }); admin.balance = newBalance; }
    await db.ref(`tournaments/${id}`).remove();
    alert(`✅ Tournament deleted!\nRefunded ${playerCount} players: ₹${totalRefund}`);
    await loadData();
    home();
};

