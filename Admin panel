        const name = document.getElementById('tName').value.trim();
        const type = document.getElementById('tType').value;
        const mode = document.getElementById('tMode').value;
        const version = document.getElementById('tVersion').value;
        const map = document.getElementById('tMap').value;
        let fees = parseInt(document.getElementById('tFees').value);
        const perKill = parseInt(document.getElementById('tPerKill').value) || 0;
        const maxPlayers = parseInt(document.getElementById('tMax').value);
        const date = document.getElementById('tDate').value;
        const time = document.getElementById('tTime').value;
        const rules = document.getElementById('tRules').value || "1. Screen Recording MANDATORY\n2. No hacking/cheating\n3. Join on time";
        const roomId = document.getElementById('tRoomId').value.trim();
        const roomPass = document.getElementById('tRoomPass').value.trim();
        
        if(!name) return alert('❌ Enter tournament name');
        if(fees < 0) fees = 0;
        if(!maxPlayers || maxPlayers <= 0) return alert('❌ Enter max players');
        if(!date) return alert('❌ Select date');
        if(!time) return alert('❌ Select time');
        if(!roomId) return alert('❌ Enter Room ID');
        if(!roomPass) return alert('❌ Enter Room Password');
        
        const tournamentData = {
            name, type, mode, version, map, fees, perKill, maxPlayers, date, time,
            rules, roomId, roomPass,
            adminId: admin.id, adminName: admin.name,
            participants: {},
            createdAt: new Date().toISOString(),
            isFree: fees === 0
        };
        if(photoBase64) tournamentData.tournamentPhoto = photoBase64;
        
        await db.ref('tournaments').push(tournamentData);
        alert(`✅ Tournament "${name}" created!\n\n${mode} Mode | Entry: ${fees === 0 ? 'FREE' : '₹'+fees} | Prize Pool: ${fees === 0 ? 'Free Tournament' : '₹' + (fees * maxPlayers)}`);
        modal.remove();
        await loadData();
        home();
    };
    document.getElementById('closeModalBtn').onclick = () => modal.remove();
}

function uploadPhotoModal() {
