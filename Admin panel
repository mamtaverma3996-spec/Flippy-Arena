let admin = null;
let tournaments = [];
let usersCache = {};
let broadcastPhotos = [];

async function loadData() {
    const snap = await db.ref('tournaments').once('value');
    tournaments = snap.val() ? Object.entries(snap.val()).map(([id,d])=>({id,...d})) : [];
    const usersSnap = await db.ref('users').once('value');
